# Copy to deploy/.env ON THE SERVER and fill in real values.
# Never commit the real .env (it's in .gitignore).

# RDS endpoint (aws rds describe-db-instances ... Endpoint.Address)
DB_HOST=taskapp-db.xxxxxxxxxx.ap-southeast-2.rds.amazonaws.com

# Passwords for the per-service database users
AUTH_DB_PASSWORD=change-me
TASK_DB_PASSWORD=change-me

# Shared HS256 signing secret (at least 32 characters). Generate with:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Allowed browser origins (the CloudFront URL once it exists)
CORS_ORIGINS=http://localhost

# ---- Task-completion emails (optional) ----
# Leave MAIL_ENABLED=false to turn emails off. Example for AWS SES (SMTP):
#   create SMTP credentials in the SES console and verify the MAIL_FROM address/domain.
#   In the SES sandbox, recipient addresses must be verified too.
MAIL_ENABLED=false
MAIL_HOST=email-smtp.ap-southeast-2.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
MAIL_FROM=TaskFlow <no-reply@your-verified-domain.com>
# Link included in the email (the CloudFront URL)
APP_URL=https://your-cloudfront-domain.cloudfront.net
