# Copy to deploy/.env ON THE SERVER and fill in real values.
# Never commit the real .env (it's in .gitignore).

# RDS endpoint (aws rds describe-db-instances ... Endpoint.Address)
DB_HOST=taskapp-db.xxxxxxxxxx.ap-southeast-2.rds.amazonaws.com

# Passwords for the per-service database users
AUTH_DB_PASSWORD=change-me
TASK_DB_PASSWORD=change-me

# Shared HS256 signing secret (at least 32 characters). Generate with:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Allowed browser origins (the CloudFront URL once it exists)
CORS_ORIGINS=http://localhost
